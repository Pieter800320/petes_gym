rules_version = '2';

// Only Pieter's account can read and write, and only its own users/{uid} tree.
// Paste this into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    // The id is Pieter's User UID (Firebase console → Authentication → Users). A wrong id here locks Pieter out too.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid && uid == 'Sq3GTmAXBpSTnFQZ8f4oqrj4hD03';
    }

    // Fitness Profile links. A client has no account: whoever holds the link (it contains the
    // invite's random id) may read the invite while it is unanswered and send the answers once.
    // Only the answers and their time can be set, never anything else, and an answered invite can
    // no longer be read or changed through the link. Listing invites is never allowed.
    match /users/{uid}/invites/{token} {
      allow get: if resource.data.answeredAt == null;
      allow update: if resource.data.answeredAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['answers', 'answeredAt'])
        && request.resource.data.answeredAt is number
        && request.resource.data.answers is map
        && request.resource.data.answers.size() <= 40;
    }
  }
}
